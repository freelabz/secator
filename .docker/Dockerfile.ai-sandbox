# syntax=docker/dockerfile:1
#
# AI run_shell sandbox image (Path A — gVisor+DinD isolation).
#
# This is NOT a secator image. It is the throwaway container the AI assistant's arbitrary
# `run_shell` commands run inside when the AI task is launched with `--isolated`
# (see secator/ai/actions.py::_ensure_sandbox_container + gke-admin/docs/ai-shell-isolation-spec.md).
#
# Kali-rolling gives the offensive toolset; we pre-bake the common deps so the AI doesn't
# `apt-get install` on every session. dockerd runs in the (gVisor-sandboxed) worker pod; this
# image is pulled and run nested. Keep it lean — extra tooling is one `apt-get` away at runtime.
#
# Build & push (pin the pulled tag by digest in the runtime config):
#   docker build -f .docker/Dockerfile.ai-sandbox -t <registry>/ai-sandbox:<tag> .
#   docker push <registry>/ai-sandbox:<tag>
FROM kalilinux/kali-rolling

ENV DEBIAN_FRONTEND=noninteractive

# Common run_shell needs: clone/build/run PoCs, ssh out, HTTP, scripting, crypto libs
# (the missing SSH crypto libs were a concrete exploit blocker — see the AI retro).
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl wget git \
      python3 python3-pip python3-venv python3-paramiko \
      openssh-client netcat-traditional dnsutils iputils-ping \
      build-essential jq unzip \
    && rm -rf /var/lib/apt/lists/*

# Unprivileged default user; /work is the per-session working dir (a Docker volume is mounted
# here by _ensure_sandbox_container). The container is started as `sleep infinity` and driven
# via `docker exec`.
RUN useradd -m -s /bin/bash sbx && mkdir -p /work && chown sbx:sbx /work
WORKDIR /work
USER sbx
