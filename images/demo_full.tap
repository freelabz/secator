# List workspaces...
secator ws list
Sleep 2s

# Create a new workspace (one per pentest)...
secator ws use demo
Sleep 1s

# Let's see what the host scan can do for us...
secator s host -tree
Sleep 2s

# Now we want to add a target, some ports to scan, and enable hunting secrets in HTTP responses...
Up 2
Left 6
Space 1
localhost -p 6379,8080 --hunt-secrets  # noenter
Sleep 500ms
Enter
Wait+Line
Sleep 3s

# Profiles can help us quickly set global and per-task options...
secator p list
Sleep 2s

# Let's use the aggressive profile, but override the rate limit at 100k/s,
# and select only nuclei templates containing 'redis' in their tags...
Up 5
Backspace 5
-pf aggressive -rl 100000 -tc 'contains(tags, "redis")' -dry
Sleep 2s
Up 2
Back 5
Type " # run it for real now !"
Enter
Wait+Line
Sleep 5s
clear

# List reports
secator r list -ws demo  # list runs in workspace 'demo' only
Sleep 3s

# Get info on specific report (current workspace)
secator r info scans/2
Sleep 3s
clear

# Find out what's running on localhost:6379 (current workspace)...
secator r show -q 'port.host == "localhost" && port.port == 6379' --dedupe
Sleep 2s

# Query all vulnerabilities (current workspace)...
secator r show -q vulnerability
Sleep 2s

# ... or filter on severity 'high' and above
secator r show -q 'vulnerability.severity in ["high", "critical"]' --dedupe
Sleep 2s

# ... or filter on vulnerabilities marked as 'exploitable'
secator r show -q 'vulnerability.tags ~= "exploitable"'
Sleep 2s

Up 2
Space 1
-o table  # display as table instead !
Sleep 2s

# Get related exploits / POCs
secator r show -q 'exploit.cves ~= 'CVE-2022-0543''
Sleep 2s
